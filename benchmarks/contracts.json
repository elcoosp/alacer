  "test_enforced_gates": [
    {
      "id": "pass_system_overhead_15_percent",
      "gate": "pass-system overhead < 15% on 10k-node churn",
      "cite": "architecture §18 M1 gate, §7.2",
      "enforced_by": "alacer_core::passes tests + benches/pass_overhead.rs"
    },
    {
      "id": "tree_update_p99_half_ms",
      "gate": "incremental TreeUpdate p99 < 0.5 ms @ 1k nodes",
      "cite": "architecture §18 M3 exit gate, ADR-0009",
      "enforced_by": "alacer-testing/tests/m3_exit_criteria.rs"
    },
    {
      "id": "patch_frame_budget",
      "gate": "one hot patch ⇒ exactly one layout+paint cycle",
      "cite": "architecture §18 M4 exit gate, ADR-0010",
      "enforced_by": "alacer-testing/tests/m4_exit_criteria.rs"
    },
    {
      "id": "w1_zero_measure_scroll",
      "gate": "translation-only scrolling: zero measure calls",
      "cite": "architecture §8.2, ADR-0008",
      "enforced_by": "alacer-testing/tests/m0_exit_criteria.rs"
    },
    {
      "id": "w2_no_rewrap_oscillation",
      "gate": "text-dense relayout: no re-wrap oscillation under ±5% width jitter",
      "cite": "architecture §14.2 W2, §8.3 integer wrap rounding (ADR-0012)",
      "enforced_by": "alacer-layout/tests/w2_gate.rs"
    },
    {
      "id": "w5_one_rerun_per_batch",
      "gate": "one write batch ⇒ one effect rerun at 10k-signal scale; memos never glitch",
      "cite": "architecture §14.2 W5, ADR-6",
      "enforced_by": "alacer-testing/tests/m6_exit_criteria.rs"
    },
    {
      "id": "comparison_corpus_published",
      "gate": "the cross-framework comparison (declared rig + results + dashboard section) is committed, schema-valid, and same-host; the beat verdict is computable from the committed file",
      "cite": "architecture §1 (the v1 definition of done's beat), §14.1, ADR-0013",
      "enforced_by": "alacer-testing/tests/m7_exit_criteria.rs"
    }
